datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Role {
  id      String  @id @default(cuid())
  name    String
  nameTh  String  @default("")
  perms   Json // array of permission keys, or ["*"] for admin
  contact String  @default("")
  system  Boolean @default(false)
  canSeeAdvances Boolean @default(false)
  approverKey String? // faculty_finance | faculty_purchasing | null — which category approver track this role represents, if any
  users   User[]
}

model User {
  id            String         @id @default(cuid())
  name          String
  username      String         @unique
  passwordHash  String
  dept          String         @default("")
  roleId        String
  role          Role           @relation(fields: [roleId], references: [id])
  email         String         @default("")
  emailNotify   Boolean        @default(false)
  notifications Notification[]
}

model Category {
  id            String  @id @default(cuid())
  name          String
  nameTh        String  @default("")
  icon          String  @default("ph-tag")
  docsPre               Json    @default("[]") // document names required before disbursement
  docsPost              Json    @default("[]") // document names required to close the request, after disbursement
  docExamples           Json    @default("{}") // { [docName]: { link, name } } — an example file shown beside that checklist item
  requireCompletionDocs Boolean @default(true) // whether docsPost must be submitted before the request can reach "closed"
  notes         String  @default("")
  defaultAcctId String?
  active        Boolean @default(true) // soft-close, never hard-delete — existing requests still reference categoryId
  allowDirect   Boolean @default(false) // may be reimbursed without a projected-expense advance
  vendorRequired Boolean @default(false) // this category always involves an external supplier — vendor name is mandatory at submission
  defaultPaidVia String @default("finance") // finance | purchasing | psat — who typically processes this category's payments
  approverRole   String @default("faculty_finance") // faculty_finance | faculty_purchasing — which approver track verifies this category
}

model MasterDoc {
  id        String  @id @default(cuid())
  name      String  @unique
  vendorDoc Boolean @default(false)
}

model Account {
  id      String  @id @default(cuid()) // "faculty" | "project" seeded explicitly; new accounts get a generated id
  name    String
  nameTh  String  @default("")
  icon    String  @default("ph-bank")
  balance Float   @default(0)
  active  Boolean @default(true)
}

model Stream {
  id      String  @id @default(cuid()) // a "purse" — a named sub-total inside an Account
  acctId  String
  name    String
  nameTh  String  @default("")
  color   String  @default("#f0378a")
  balance Float   @default(0)
  active  Boolean @default(true)
}

model Txn {
  id       String   @id @default(cuid())
  acctId   String
  streamId String?
  type     String // "in" | "out"
  amount   Float
  desc     String
  date     DateTime @default(now())
}

model Request {
  id                String   @id // e.g. RB-1042
  title             String
  categoryId        String
  amount            Float
  dept              String
  requesterId       String?
  requesterName     String
  status            String   @default("notified")
  desc              String   @default("")
  driveFolder       String   @default("")
  // docs: [{name, submitted, link, fileName,
  //          disc: {open, note, by, ts, fixed, fixedNote} | null}]
  docs              Json
  eventDate         DateTime @default(now())
  acctId            String?
  projectionId      String?
  directClaim       Boolean  @default(false)
  disburseProofLink String   @default("")
  vendor            String   @default("")
  vendorExists      Boolean?
  paidVia           String   @default("finance")
  po                Json?
  payProof          Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Projection {
  id            String   @id // e.g. PJ-2000
  title         String
  categoryId    String
  dept          String
  requesterId   String?
  requesterName String
  amount        Float
  expectedDate  DateTime @default(now())
  status        String   @default("submitted") // submitted | advanced | linked | settled
  requestId     String?
  createdAt     DateTime @default(now())
}

model Revenue {
  id           String    @id // e.g. RV-3000
  title        String
  source       String    @default("")
  acctId       String    @default("project")
  streamId     String?
  amount       Float
  expectedDate DateTime  @default(now())
  status       String    @default("projected") // projected | received
  receivedAt   DateTime?
  createdAt    DateTime  @default(now())
}

model Notification {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text   String
  type   String   @default("notified")
  read   Boolean  @default(false)
  ts     DateTime @default(now())
}

model Audit {
  id     String   @id @default(cuid())
  user   String
  role   String
  action String
  ts     DateTime @default(now())
}

model Counter {
  id    String @id
  value Int
}
