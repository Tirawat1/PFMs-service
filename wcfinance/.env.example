# ---- copy to .env and fill in before first run ----

# Postgres connection used by Prisma and the app
DATABASE_URL="postgresql://wcfinance:change-me@db:5432/wcfinance?schema=public"

# Credentials the db container is created with (must match DATABASE_URL)
POSTGRES_USER=wcfinance
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wcfinance

# 32+ random chars. Generate: openssl rand -base64 48
AUTH_SECRET=

# Public origin of the deployment, no trailing slash
APP_URL=http://localhost:3000

# Seeded admin account (created by npm run db:seed)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_ADMIN_EMAIL=finance@example.ac.th

# Optional: run migrations automatically on container start
RUN_MIGRATIONS_ON_BOOT=true

# Optional SMTP for email notifications. Leave blank to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="WCFinance <no-reply@example.ac.th>"
